    "dev:fresh": "npm run clean && npm install && npm run dev",
    "prestart": "node scripts/free-default-port.cjs",
    "build": "next build",
    "build:clean": "npm run clean && next build",
    "postbuild": "node scripts/flatten-server-chunks.cjs && node scripts/publish-css-fallback.cjs",
    "fix:chunks": "node scripts/flatten-server-chunks.cjs",
    "css:fallback": "node scripts/publish-css-fallback.cjs",
    "start": "next start -p 3000",
    "health:check": "node scripts/run-production-health-check.cjs",
    "qa:integrity": "node scripts/verify-product-integrity.cjs",
    "qa:claims": "node scripts/audit-customer-claim-integrity.cjs",
    "qa:claims:repair": "node scripts/repair-customer-account-integrity.cjs",
    "qa:login": "node scripts/qa-customer-login.cjs",
    "qa:password-reset": "node scripts/qa-password-reset.cjs",
    "qa:contact": "node scripts/qa-customer-contact.cjs",
    "qa:vehicles": "node scripts/qa-customer-vehicles.cjs",
    "qa:photos": "node scripts/qa-customer-photos.cjs",
    "qa:memberships": "node scripts/qa-customer-memberships.cjs",
    "qa:rewards": "node scripts/qa-customer-rewards.cjs",
    "qa:referrals": "node scripts/qa-customer-referrals.cjs",
    "qa:messages": "node scripts/qa-customer-messages.cjs",
    "qa:deposit:rules": "node scripts/qa-deposit-lifecycle.cjs",
    "qa:deposit": "node scripts/qa-deposit-lifecycle.cjs && node scripts/qa-customer-deposit.cjs",
    "qa:balance": "node scripts/qa-deposit-lifecycle.cjs && node scripts/qa-customer-deposit.cjs",
    "qa:manual-payments": "node scripts/qa-manual-payments.cjs",
    "qa:refunds": "node scripts/qa-refunds.cjs",
    "qa:invoices": "node scripts/qa-invoices.cjs",
    "qa:receipts": "node scripts/qa-receipts.cjs",
    "qa:payment-status": "node scripts/qa-payment-status.cjs",
    "qa:appointment-confirmation": "node scripts/qa-appointment-confirmation.cjs",
    "qa:portal": "npm run qa:integrity && npm run qa:claims && npm run qa:login && npm run qa:password-reset && npm run qa:contact && npm run qa:vehicles && npm run qa:photos && npm run qa:memberships && npm run qa:rewards && npm run qa:referrals && npm run qa:messages"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "next": "^15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
